# Leave empty to run with rules only (unreadable rows are marked "AI chưa được bật").
OPENAI_API_KEY=
# Required when OPENAI_API_KEY is set. Confirm the model exists on your OpenAI account.
OPENAI_MODEL=
# Server ceilings for /api/ai. Users can lower these in "Cài đặt AI" (saved in their browser), never raise them.
AI_MAX_TEXTS=1000
AI_MAX_TEXT_LENGTH=500
AI_MAX_CONCURRENCY=10
